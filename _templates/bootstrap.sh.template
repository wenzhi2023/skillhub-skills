#!/usr/bin/env bash
# 依赖安装脚本模板：别人装了这个 skill 后运行一次
set -e
echo "[1/3] 检查基础命令"
for c in curl python3; do command -v $c >/dev/null || { echo "缺少 $c，请先安装"; exit 1; }; done
echo "[2/3] 安装可选依赖（按需修改）"
# sudo apt-get install -y whois dnsutils   # Debian/Ubuntu
echo "[3/3] 环境变量"
[ -f "$HOME/.config/xxx.env" ] || echo "⚠️ 请创建 ~/.config/xxx.env 并填入 XXX_KEY"
echo "✅ 完成"
